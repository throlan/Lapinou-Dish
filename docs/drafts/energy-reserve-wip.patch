@@ -0,0 +1,116 @@
+import { randomUUID } from 'node:crypto';
+import { lockHouseholdInventory } from './ingredient-stock.mjs';
+import { readRecipe } from './recipes.mjs';
+
+export const RESERVE_SLOT_SHARES = { lunch:0.5,dinner:0.375,snack:0.125,breakfast:0 };
+const ratios={breakfast:0.2,lunch:0.4,dinner:0.3,snack:0.1};
+export const isReserveUuid = v=>typeof v==='string' && /^[\da-f]{8}-(?:[\da-f]{4}-){3}[\da-f]{12}$/i.test(v);
+export const isReserveDate = v=>typeof v==='string' && /^\d{4}-\d{2}-\d{2}$/.test(v) && !Number.isNaN(Date.parse(v)) && new Date(v).toISOString().slice(0,10)===v;
+const addDays=(v,n)=>{const d=new Date(v+'T12:00:00Z');d.setUTCDate(d.getUTCDate()+n);return d.toISOString().slice(0,10);};
+export function reservePeriodEnd(start,type){
+  if(type==='week')return addDays(start,6);
+  const d=new Date(start+'T12:00:00Z');d.setUTCMonth(d.getUTCMonth()+1);d.setUTCDate(0);return d.toISOString().slice(0,10);
+}
+export function reserveSlotReduction(daily,slot){return Number(daily)*(RESERVE_SLOT_SHARES[slot]??0);}
+export function isAdultAt(birthDate,date){
+  if(!birthDate)return null;
+  const born=String(birthDate).slice(0,10);const cutoff=new Date(date+'T12:00:00Z');cutoff.setUTCFullYear(cutoff.getUTCFullYear()-18);
+  return born<=cutoff.toISOString().slice(0,10);
+}
+export function validateReservePeriod(input){
+  if(!input || !isReserveUuid(input.householdId)||!isReserveUuid(input.personId)||!isReserveDate(input.startsOn)
+    || !['week','month'].includes(input.periodType)||input.adultConfirmed!==true
+    || typeof input.dailyKcal!=='number'||!Number.isFinite(input.dailyKcal)||input.dailyKcal<=0||input.dailyKcal>100000
+    || (input.periodType==='week'?new Date(input.startsOn+'T12:00:00Z').getUTCDay()!==1:input.startsOn.slice(8)!=='01'))return {error:'invalid-energy-reserve'};
+  return {data:{...input,endsOn:reservePeriodEnd(input.startsOn,input.periodType)}};
+}
+
+export async function saveReservePeriod(pool,data){
+  const client=await pool.connect();
+  try{
+    await client.query('BEGIN');await lockHouseholdInventory(client,data.householdId);
+    const person=(await client.query('SELECT birth_date::text AS birth_date FROM people WHERE id=$1 AND household_id=$2 AND active=true',[data.personId,data.householdId])).rows[0];
+    if(!person || isAdultAt(person.birth_date,data.startsOn)===false){await client.query('ROLLBACK');return {error:person?'energy-reserve-adults-only':'person-not-in-household'};}
+    const profile=(await client.query('SELECT daily_energy_kcal FROM person_profile_history WHERE person_id=$1 AND effective_from<=$2 ORDER BY effective_from DESC LIMIT 1',[data.personId,data.startsOn])).rows[0];
+    if(!profile?.daily_energy_kcal || data.dailyKcal>=Number(profile.daily_energy_kcal)){await client.query('ROLLBACK');return {error:'energy-reserve-target-required'};}
+    const overlaps=await client.query('SELECT id FROM energy_reserve_periods WHERE person_id=$1 AND starts_on<=$3 AND ends_on>=$2 AND NOT(starts_on=$2 AND ends_on=$3)',[data.personId,data.startsOn,data.endsOn]);
+    if(overlaps.rows.length){await client.query('ROLLBACK');return {error:'energy-reserve-period-overlap'};}
+    const saved=await client.query(`INSERT INTO energy_reserve_periods(id,household_id,person_id,period_type,starts_on,ends_on,daily_kcal,adult_confirmed)
+      VALUES($1,$2,$3,$4,$5,$6,$7,true) ON CONFLICT(person_id,starts_on) DO UPDATE SET daily_kcal=EXCLUDED.daily_kcal,period_type=EXCLUDED.period_type,ends_on=EXCLUDED.ends_on RETURNING id`,[randomUUID(),data.householdId,data.personId,data.periodType,data.startsOn,data.endsOn,data.dailyKcal]);
+    await client.query('COMMIT');return {id:saved.rows[0].id};
+  }catch(error){await client.query('ROLLBACK');throw error;}finally{client.release();}
+}
