+export async function removeReservePeriod(pool,householdId,id){
+  const result=await pool.query('DELETE FROM energy_reserve_periods WHERE household_id=$1 AND id=$2 RETURNING id',[householdId,id]);return Boolean(result.rowCount);
+}
+
+// Preview existing future meals. Manual confirmation applies only the exact quantities previewed.
+export async function reservePortionPreview(pool,householdId,id,today){
+  const recipeCache=new Map();
+  const period=(await pool.query(`SELECT r.*,r.starts_on::text AS starts_on,r.ends_on::text AS ends_on,p.birth_date::text AS birth_date FROM energy_reserve_periods r JOIN people p ON p.id=r.person_id WHERE r.id=$1 AND r.household_id=$2`,[id,householdId])).rows[0];
+  if(!period)return {error:'energy-reserve-not-found'};
+  if(isAdultAt(period.birth_date,today)===false)return {error:'energy-reserve-adults-only'};
+  const meals=(await pool.query(`SELECT m.id,m.meal_date::text AS date,m.slot,
+    (SELECT daily_energy_kcal FROM person_profile_history WHERE person_id=$2 AND effective_from<=m.meal_date ORDER BY effective_from DESC LIMIT 1) AS target
+    FROM planned_meals m JOIN planned_meal_attendees a ON a.meal_id=m.id AND a.person_id=$2
+    WHERE m.household_id=$1 AND NOT m.is_occasion AND m.meal_date BETWEEN GREATEST($3::date,$5::date) AND $4::date ORDER BY m.meal_date,m.slot`,[householdId,period.person_id,period.starts_on,period.ends_on,today])).rows;
+  const changes=[],warnings=[];
+  const groups=new Map();for(const meal of meals){const key=meal.date+':'+meal.slot;groups.set(key,[...(groups.get(key)??[]),meal]);}
+  for(const group of groups.values()){
+    const first=group[0];const reduction=reserveSlotReduction(period.daily_kcal,first.slot);if(!reduction)continue;
+    const desired=Math.max(0,Number(first.target)*ratios[first.slot]-reduction);
+    const rows=[];let known=first.target!=null;
+    for(const meal of group){
+      const amounts=(await pool.query('SELECT i.id,i.recipe_id,i.role,a.quantity FROM planned_meal_items i JOIN planned_amounts a ON a.planned_item_id=i.id AND a.person_id=$2 WHERE i.meal_id=$1 ORDER BY i.id',[meal.id,period.person_id])).rows;
+      for(const row of amounts){if(!recipeCache.has(row.recipe_id))recipeCache.set(row.recipe_id,await readRecipe(pool,row.recipe_id));row.recipe=recipeCache.get(row.recipe_id);row.quantity=Number(row.quantity);row.mealId=meal.id;rows.push(row);if(row.recipe?.nutrition?.perYieldUnit?.energyKcal==null || row.recipe?.nutrition?.perYieldUnit?.proteinG==null)known=false;}
+    }
+    if(!known){warnings.push(`${first.date} ${first.slot} : données nutritionnelles manquantes, portions conservées.`);continue;}
+    const kcal=row=>row.quantity*row.recipe.nutrition.perYieldUnit.energyKcal;
+    const total=rows.reduce((sum,row)=>sum+kcal(row),0);
+    if(total<=desired+0.01)continue;
+    const shared=rows.filter(row=>['main','accompaniment'].includes(row.role??'main'));
+    const fixed=total-shared.reduce((sum,row)=>sum+kcal(row),0);
+    const adjustable=total-fixed;
+    const factor=adjustable>0?Math.max(0,(desired-fixed)/adjustable):0;
+    if(!factor){warnings.push(`${first.date} ${first.slot} : réserve incompatible avec les choix fixes, portions conservées.`);continue;}
+    const proposed=shared.map(row=>{const raw=row.quantity*factor,unit=row.recipe.yield.unitId;return {...row,next:unit==='g'||unit==='ml'?Math.floor(raw*100)/100:Math.floor(raw/(unit==='piece'?1:0.5))*(unit==='piece'?1:0.5)};});
+    const protein=rows.reduce((sum,row)=>sum+row.quantity*row.recipe.nutrition.perYieldUnit.proteinG,0);
+    const nextProtein=rows.filter(row=>!shared.includes(row)).reduce((sum,row)=>sum+row.quantity*row.recipe.nutrition.perYieldUnit.proteinG,0)+proposed.reduce((sum,row)=>sum+row.next*row.recipe.nutrition.perYieldUnit.proteinG,0);
+    if(proposed.some(row=>row.next<=0) || nextProtein<Math.min(40,protein)-0.01){warnings.push(`${first.date} ${first.slot} : portions conservées pour garder les protéines et des quantités positives.`);continue;}
+    changes.push(...proposed.filter(row=>row.next<row.quantity).map(row=>({itemId:row.id,mealId:row.mealId,personId:period.person_id,before:row.quantity,after:row.next,name:row.recipe.name,date:first.date,slot:first.slot,unitId:row.recipe.yield.unitId})));
+  }
+  return {changes,warnings};
+}
+
+export async function applyReservePortions(pool,householdId,id,today,expected){
+  if(!Array.isArray(expected)||expected.length>500)return {error:'invalid-reserve-adjustments'};
+  const client=await pool.connect();
+  try{
+    await client.query('BEGIN');await lockHouseholdInventory(client,householdId);
+    const preview=await reservePortionPreview(client,householdId,id,today);if(preview.error){await client.query('ROLLBACK');return preview;}
+    if(JSON.stringify(preview.changes)!==JSON.stringify(expected)){await client.query('ROLLBACK');return {error:'reserve-preview-changed'};}
+    for(const change of preview.changes)await client.query('UPDATE planned_amounts SET quantity=$3 WHERE planned_item_id=$1 AND person_id=$2',[change.itemId,change.personId,change.after]);
+    await client.query('COMMIT');return {changed:preview.changes.length,warnings:preview.warnings};
+  }catch(error){await client.query('ROLLBACK');throw error;}finally{client.release();}
+}
