+export async function listReservePeriods(pool,householdId,start,end){
+  const periods=(await pool.query(`SELECT r.id,r.person_id AS "personId",p.display_name AS name,r.period_type AS "periodType",r.starts_on::text AS "startsOn",r.ends_on::text AS "endsOn",r.daily_kcal AS "dailyKcal"
+    FROM energy_reserve_periods r JOIN people p ON p.id=r.person_id WHERE r.household_id=$1 AND r.starts_on<=$3 AND r.ends_on>=$2 ORDER BY p.display_name,r.starts_on`,[householdId,start,end])).rows;
+  for(const period of periods){
+    period.dailyKcal=Number(period.dailyKcal);
+    const days=Math.round((Date.parse(period.endsOn)-Date.parse(period.startsOn))/86400000)+1;
+    period.programmedKcal=days*period.dailyKcal;
+    const occasions=(await pool.query(`SELECT m.id,m.meal_date::text AS date,m.slot,m.occasion_title AS title,e.energy_kcal,
+      (SELECT daily_energy_kcal FROM person_profile_history WHERE person_id=$2 AND effective_from<=m.meal_date ORDER BY effective_from DESC LIMIT 1) AS daily_target
+      FROM planned_meals m JOIN planned_meal_attendees a ON a.meal_id=m.id AND a.person_id=$2
+      LEFT JOIN planned_occasion_energy e ON e.meal_id=m.id AND e.person_id=$2
+      WHERE m.household_id=$1 AND m.is_occasion AND m.meal_date BETWEEN $3 AND $4`,[householdId,period.personId,period.startsOn,period.endsOn])).rows;
+    period.complete=occasions.every(o=>o.energy_kcal!=null && o.daily_target!=null);
+    period.occasions=occasions.map(o=>({id:o.id,date:o.date,title:o.title,energyKcal:o.energy_kcal==null?null:Number(o.energy_kcal),extraKcal:o.energy_kcal==null||o.daily_target==null?null:Math.max(0,Number(o.energy_kcal)-Number(o.daily_target)*ratios[o.slot])}));
+    period.usedKcal=period.complete?period.occasions.reduce((sum,o)=>sum+o.extraKcal,0):null;
+    period.availableKcal=period.usedKcal==null?null:period.programmedKcal-period.usedKcal;
+  }
+  return periods;
+}
