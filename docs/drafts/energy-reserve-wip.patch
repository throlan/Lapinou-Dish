@@ -0,0 +1,17 @@
+CREATE TABLE IF NOT EXISTS energy_reserve_periods (
+  id uuid PRIMARY KEY, household_id uuid NOT NULL REFERENCES households(id) ON DELETE CASCADE,
+  person_id uuid NOT NULL REFERENCES people(id) ON DELETE CASCADE,
+  period_type text NOT NULL CHECK(period_type IN ('week','month')),
+  starts_on date NOT NULL, ends_on date NOT NULL CHECK(ends_on >= starts_on),
+  daily_kcal numeric(10,2) NOT NULL CHECK(daily_kcal > 0),
+  adult_confirmed boolean NOT NULL DEFAULT false,
+  UNIQUE(person_id,starts_on)
+);
+ALTER TABLE planned_meals ADD COLUMN IF NOT EXISTS is_occasion boolean NOT NULL DEFAULT false;
+ALTER TABLE planned_meals ADD COLUMN IF NOT EXISTS occasion_title text NOT NULL DEFAULT '';
+CREATE TABLE IF NOT EXISTS planned_occasion_energy (
+  meal_id uuid NOT NULL REFERENCES planned_meals(id) ON DELETE CASCADE,
+  person_id uuid NOT NULL REFERENCES people(id) ON DELETE CASCADE,
+  energy_kcal numeric(10,2) NOT NULL CHECK(energy_kcal >= 0 AND energy_kcal <= 100000),
+  PRIMARY KEY(meal_id,person_id)
+);
