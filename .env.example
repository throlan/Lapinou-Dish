POSTGRES_PASSWORD=replace-with-a-long-random-database-password
APP_PASSWORD=replace-with-a-different-long-family-password
# Optional: server-side recipe extraction. Never put a real key in Git or the browser.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_RECIPE_MODEL=gpt-4.1-mini
# Optional server-side export to one Home Assistant todo list per store.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=
